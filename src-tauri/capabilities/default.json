{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "windows": ["main"],
  "permissions": [
    "window-state:default",
    "core:default",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",    
    "process:allow-exit",
    
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "dialog:allow-open",
      "allow": [
        "**",
        "**/*"
      ]
    },
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCONFIG/**/*" },
        { "path": "$APPCONFIG/*" },
        { "path": "$APPDATA/**/*" },
        { "path": "$APPDATA/*" },
        { "path": "$APPLOCALDATA/**/*" },
        { "path": "$APPLOCALDATA/*" },
        { "path": "$CONFIG/**/*" },
        { "path": "$CONFIG/*" },
        { "path": "$DATA/**/*" },
        { "path": "$DATA/*" },
        { "path": "$LOCALDATA/**/*" },
        { "path": "$LOCALDATA/*" }
      ],
      "requireLiteralLeadingDot": false
    },
    
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "path" : "**" },
        { "path" : "**/*" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": true,
          "name": "ffprobe",
          "cmd": "ffprobe"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "ffprobe",
          "cmd": "ffprobe"
        }
      ]
    },
    
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api4.thetvdb.com/v4/*" },
        { "url": "https://www.googleapis.com/youtube/v3/*" }
      ]
    },
    
    "sql:default",
    "sql:allow-execute",
    
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*",
          "app": true
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPCACHE/**/*" },
        { "path": "$APPCACHE/*" },
        { "path": "$APPCONFIG/**/*" },
        { "path": "$APPCONFIG/*" },
        { "path": "$APPDATA/**/*" },
        { "path": "$APPDATA/*" },
        { "path": "$APPLOCALDATA/**/*" },
        { "path": "$APPLOCALDATA/*" },
        { "path": "$CACHE/**/*" },
        { "path": "$CACHE/*" },
        { "path": "$CONFIG/**/*" },
        { "path": "$CONFIG/*" },
        { "path": "$DATA/**/*" },
        { "path": "$DATA/*" },
        { "path": "$DESKTOP/**/*" },
        { "path": "$DESKTOP/*" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$DOCUMENT/*" },
        { "path": "$DOWNLOAD/**/*" },
        { "path": "$DOWNLOAD/*" },
        { "path": "$HOME/**/*" },
        { "path": "$HOME/*" },
        { "path": "$LOCALDATA/**/*" },
        { "path": "$LOCALDATA/*" },
        { "path": "$PICTURE/**/*" },
        { "path": "$PICTURE/*" },
        { "path": "$PUBLIC/**/*" },
        { "path": "$PUBLIC/*" },
        { "path": "$RESOURCE/**/*" },
        { "path": "$RESOURCE/*" },
        { "path" : "/media/**/*" },
        { "path" : "/media/*" },
        { "path": "/**" }
      ],
      "requireLiteralLeadingDot": false
    }
  ]
}